{
  "name": "qq-dsh-panel",
  "version": "0.7.1",
  "description": "DSH Desktop 浮游球工具箱：可拖动的角落小球，面板里以开关形式管理功能。当前含两个功能——「思考链中文」（模型从源头用中文推理）与「QQ 大肥鱼」（把 DeepSeek 部署到 QQ 群：桥接状态、回复节奏、人格、长期记忆、群友印象、Token 用量、表情素材、访问控制、后端切换、连接诊断共 11 个页签）。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "thinking",
    "reasoning",
    "chinese",
    "qq",
    "qq-bridge",
    "floatdock"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "scripts": {
    "test": "node scripts/smoke.mjs"
  },
  "license": "MIT"
}
