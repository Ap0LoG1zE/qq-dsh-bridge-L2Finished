{
  "name": "@local/qq-compact-v2",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "提供 /compact-v2 命令：按「保留尾部 N 万 token」压缩会话历史。绕开 DSH 自带 /compact 把 retainTokens 硬编码成 0 的问题。",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
